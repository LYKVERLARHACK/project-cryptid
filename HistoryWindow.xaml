<Window x:Class="RealityCheckDesktop.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Incident History" Width="1040" Height="720" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#111315" Foreground="#E2E4E6"
        FontFamily="Segoe UI" Topmost="True" ShowInTaskbar="True">
  <Window.Resources>
    <Style TargetType="{x:Type Button}">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="11,4"/>
      <Setter Property="Background" Value="#25282B"/>
      <Setter Property="BorderBrush" Value="#3A3E42"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#E2E4E6"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="2" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonSurface" Property="Background" Value="#323639"/>
                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#555B60"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonSurface" Property="Background" Value="#3A3E42"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.42"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#D0D3D5"/>
      <Setter Property="BorderBrush" Value="#D0D3D5"/>
      <Setter Property="Foreground" Value="#141618"/>
    </Style>
    <Style TargetType="{x:Type TextBox}">
      <Setter Property="Background" Value="#191C1F"/>
      <Setter Property="BorderBrush" Value="#383C40"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#E2E4E6"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="CaretBrush" Value="#E2E4E6"/>
      <Setter Property="SelectionBrush" Value="#686E73"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="{x:Type ListBoxItem}">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ListBoxItem}">
            <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" CornerRadius="2">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="#25282B"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="#303438"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="INCIDENT HISTORY" FontSize="18" FontWeight="SemiBold" Foreground="#ECEEEF"/>
        <TextBlock Text="Analysis results and follow-up questions are stored on this device."
                   Foreground="#92989D" FontSize="11" Margin="0,3,0,0"/>
      </StackPanel>
      <Button Content="Refresh" HorizontalAlignment="Right" VerticalAlignment="Center" Click="RefreshButton_Click"/>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Background="#191C1F" BorderBrush="#2D3135" BorderThickness="1" CornerRadius="3" Padding="9">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="RECENT CHECKS" FontSize="10" FontWeight="SemiBold" Foreground="#A7ADB2"
                     FontFamily="Consolas" Margin="3,2,3,9"/>
          <ListBox x:Name="IncidentsList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                   Foreground="#E2E4E6" SelectionChanged="IncidentsList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="Transparent" BorderBrush="#303438" BorderThickness="1"
                        CornerRadius="2" Padding="9">
                  <StackPanel>
                    <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="12"
                               TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                    <TextBlock Text="{Binding DisplaySubtitle}" Foreground="#969CA1" FontSize="10"
                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
      <Grid x:Name="IncidentContent" Grid.Column="1" Margin="12,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="190"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
          <StackPanel>
            <TextBlock x:Name="IncidentTitle" Text="Select an incident" FontSize="17" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="IncidentMeta" Foreground="#92989D" FontSize="10" Margin="0,3,0,0"/>
          </StackPanel>
          <Button x:Name="OpenVideoButton" Content="Open video" HorizontalAlignment="Right"
                  VerticalAlignment="Center" Click="OpenVideoButton_Click" Visibility="Collapsed"/>
        </Grid>
        <Border Grid.Row="1" Background="#191C1F" BorderBrush="#2D3135" BorderThickness="1"
                CornerRadius="3" Padding="11" Margin="0,9,0,10">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="SUMMARY" FontSize="10" FontWeight="SemiBold" Foreground="#A7ADB2"
                         FontFamily="Consolas" Margin="0,0,0,5"/>
              <TextBlock x:Name="IncidentSummary" TextWrapping="Wrap" FontSize="12"/>
              <TextBlock Text="EXPLANATION" FontSize="10" FontWeight="SemiBold" Foreground="#A7ADB2"
                         FontFamily="Consolas" Margin="0,10,0,4"/>
              <TextBlock x:Name="IncidentExplanation" TextWrapping="Wrap" FontSize="12"/>
              <TextBlock Text="CLAIMS / FINDINGS / SOURCES" FontSize="10" FontWeight="SemiBold"
                         Foreground="#A7ADB2" FontFamily="Consolas" Margin="0,10,0,4"/>
              <TextBlock x:Name="IncidentDetails" TextWrapping="Wrap" FontSize="10" FontFamily="Consolas"
                         Foreground="#B8BDC1"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
        <TextBlock Grid.Row="2" Text="FOLLOW-UP" FontSize="10" FontWeight="SemiBold"
                   Foreground="#A7ADB2" FontFamily="Consolas" Margin="2,0,0,7"/>
        <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="3" VerticalScrollBarVisibility="Auto"
                      Margin="0,0,0,9">
          <StackPanel x:Name="ChatMessages"/>
        </ScrollViewer>
        <Grid Grid.Row="4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="QuestionInput" AcceptsReturn="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" MinHeight="56" MaxHeight="110" Margin="0,0,7,0"
                   ToolTip="Ask a question based on this incident's saved report"/>
          <Button x:Name="SendButton" Grid.Column="1" Style="{StaticResource PrimaryButton}"
                  Content="Ask Qwen" VerticalAlignment="Bottom" Click="SendQuestion_Click"/>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="5" Foreground="#858C91" FontFamily="Consolas"
                   FontSize="10" Margin="2,6,0,0" TextWrapping="Wrap"/>
      </Grid>
      <Border x:Name="EmptyHistoryPanel" Grid.Column="1" Margin="12,0,0,0" Background="#191C1F"
              BorderBrush="#2D3135" BorderThickness="1" CornerRadius="3" Padding="24"
              Visibility="Collapsed">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
          <TextBlock Text="NO INCIDENTS YET" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                     Foreground="#C5C9CC" HorizontalAlignment="Center"/>
          <TextBlock x:Name="EmptyHistoryText"
                     Text="Run Check Claims or Check AI Content from the overlay to save your first check."
                     Foreground="#858C91" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                     Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
