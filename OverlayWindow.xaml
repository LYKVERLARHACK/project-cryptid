<Window x:Class="RealityCheckDesktop.OverlayWindow" Title="Reality Check" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" Height="72" MinWidth="460" MaxWidth="460" MinHeight="72" MaxHeight="460"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="True" Focusable="True" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="ModeButton" TargetType="Button">
      <Setter Property="Height" Value="44"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="#F3F7FC"/>
      <Setter Property="Background" Value="#153B6A"/>
      <Setter Property="BorderBrush" Value="#1B5796"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ModeButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="RootLayout" Margin="4,4,4,3">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="PopupCard" Grid.Row="0" Visibility="Collapsed" Background="#102B4C" BorderBrush="#09192D" BorderThickness="1" CornerRadius="19" Padding="14" Margin="0,0,0,7">
      <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="19" ShadowDepth="4" Opacity="0.42"/></Border.Effect>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <TextBlock x:Name="PopupEyebrow" Text="DONE ANALYSING" Foreground="#F3F7FC" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
          <Button x:Name="CloseButton" Content="×" Width="24" Height="24" Padding="0" FontSize="16" Background="#173A63" BorderBrush="#254B75" Foreground="#D7E5F5" HorizontalAlignment="Right" Click="CloseButton_Click" ToolTip="Close"/>
        </Grid>
        <Grid x:Name="ResultHeader" Grid.Row="1" Visibility="Collapsed" Margin="0,9,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border x:Name="ScoreBadge" Width="44" Height="44" CornerRadius="22" Background="#E99416" VerticalAlignment="Center">
            <TextBlock x:Name="ScoreLabel" Text="57%" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="FinalVerdictLabel" Text="FINAL VERDICT:" Foreground="#E8EFF8" FontSize="9" FontWeight="Bold" Margin="2,0,0,3"/>
            <Border x:Name="VerdictPanel" Background="#174477" CornerRadius="7" Padding="8,5">
              <TextBlock x:Name="VerdictText" Text="Assessment" Foreground="#F5F8FC" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>
          </StackPanel>
        </Grid>
        <Border x:Name="ProgressPanel" Grid.Row="1" Visibility="Collapsed" Background="#173B67" CornerRadius="15" Padding="7" Margin="0,7,0,0">
          <StackPanel>
            <TextBlock x:Name="ProgressText" Text="Analysing…" Foreground="#F4F7FB" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <ProgressBar x:Name="AnalysisProgressBar" Height="7" IsIndeterminate="True" Foreground="#0B62D1" Background="#F4F7FB" BorderThickness="0"/>
          </StackPanel>
        </Border>
        <Border x:Name="DetailPanel" Grid.Row="2" Visibility="Collapsed" Background="#173B67" CornerRadius="16" Padding="12" Margin="0,8,0,0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock x:Name="DetailCaption" Text="DETAILED ANALYSIS:" Foreground="#F0F5FB" FontSize="10" FontWeight="Bold" Margin="1,0,0,7"/>
            <ScrollViewer Grid.Row="1" MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="ContentHost"/>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Border>
    <Image x:Name="KidsCat" Grid.Row="0" Width="150" Height="171" Source="pack://application:,,,/Assets/kids-cat.png" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="28,0,0,0" Visibility="Collapsed" IsHitTestVisible="False" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="Kids mode pixel cat"/>
    <Border x:Name="DockBar" Grid.Row="1" Height="60" Background="#171B22" BorderBrush="#242A34" BorderThickness="1" CornerRadius="24" Padding="6">
      <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="3" Opacity="0.48"/></Border.Effect>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
        <Button x:Name="RealityButton" Grid.Column="0" Style="{StaticResource ModeButton}" Margin="0,0,4,0" Click="RealityButton_Click">
          <TextBlock Text="CHECK CLAIMS" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
        <Button x:Name="DetectorButton" Grid.Column="1" Style="{StaticResource ModeButton}" Margin="4,0" Click="DetectorButton_Click">
          <TextBlock Text="CHECK AI CONTENT" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
        <Button x:Name="SettingsButton" Grid.Column="2" Height="44" Padding="0" Background="#075BC3" BorderBrush="#126BD7" Foreground="White" Click="SettingsButton_Click" ToolTip="Settings">
          <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
